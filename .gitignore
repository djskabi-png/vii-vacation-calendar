# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/qa-reports/
/.codex/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.out.log
dev.err.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# AWS application bridge build artifacts and local dependency trees
/infrastructure/aws/application-bridge/node_modules/
/infrastructure/aws/application-bridge/pnpm-lock.yaml
/infrastructure/aws/application-bridge-bundle/
/infrastructure/aws/*.zip
/infrastructure/aws/application-bridge/*.zip
/infrastructure/aws/__pycache__/
/focused.log
