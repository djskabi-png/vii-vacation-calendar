{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-rsc-assets.mjs --clean && vinext build && node scripts/verify-rsc-assets.mjs && node scripts/prune-server-css-duplicates.mjs",
    "start": "vinext start",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "audit:search": "node scripts/audit-search-state.cjs",
    "audit:availability": "node scripts/audit-availability-matrix.mjs",
    "qa:site": "node scripts/audit-sitewide-release.cjs",
    "qa:production": "node scripts/audit-comprehensive-production.cjs",
    "qa:locales": "node scripts/audit-multilingual-production.cjs",
    "qa:regression-guards": "node scripts/verify-regression-guard-matrix.mjs",
    "qa:icon-geometry": "node scripts/audit-feature-icon-geometry.cjs",
    "qa:overlay-geometry": "node scripts/audit-overlay-geometry.cjs",
    "qa:responsive-transitions": "node scripts/audit-responsive-transitions.cjs",
    "qa:map": "node scripts/audit-map-experience.cjs",
    "qa:catalog-fallback": "node scripts/audit-catalog-fallback-parity.mjs",
    "qa:auth-boundaries": "node --test tests/auth-audience-separation.test.mjs tests/admin-server-gate.test.mjs tests/logout-route.test.mjs tests/account-frontend-contract.test.mjs tests/admin-command-center.test.mjs tests/admin-permissions.test.mjs tests/launch-seo.test.mjs",
    "qa:pre-professor-repairs": "node --test tests/booking-mode-contract.test.mjs tests/vii-stay-calendar.test.mjs tests/last-minute-page.test.mjs tests/geography-missing-map-points.test.mjs tests/admin-professor-intent.test.mjs tests/admin-professor-database-boundary.test.mjs tests/admin-professor-visualization.test.mjs tests/admin-business-performance-visualization.test.mjs tests/discovery-immediate-fallback.test.mjs",
    "qa:navigation-unit-results": "node --test tests/navigation-unit-results-regression.test.mjs",
    "qa:vii-unified-19": "node --test tests/vii-unified-19-regression.test.mjs tests/liran-palumbo-regression-contract.test.mjs tests/hilat-unit-gallery-recovery.test.mjs tests/vii-stay-calendar.test.mjs tests/admin-command-center.test.mjs tests/biz-conversion-cache.test.mjs tests/biz-report-runs.test.mjs tests/quality-platform.test.mjs tests/admin-reporting-database-fallback.test.mjs tests/backend-source-metadata.test.mjs",
    "qa:vii-unified-19-public": "node scripts/audit-unified-19-public.cjs",
    "qa:qqqaaa": "node scripts/run-qqqaaa.cjs",
    "qa:spacing": "node scripts/audit-header-spacing.cjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .openai",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "parse5": "8.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
